# Sen environment variables.
# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (public — safe to reach the client) ------------------------------
# Project API URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key (format sb_publishable_... or the legacy anon JWT).
# This key is public by design; row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth ----------------------------------------------------------------------
# The single email address permitted to sign in. Sen is a single-user app;
# magic links are only ever sent to this address and any other is refused.
ALLOWED_EMAIL=

# --- Server-only secrets (NEVER prefixed NEXT_PUBLIC_, never in a request path) -
# Service-role key. Used ONLY by scripts in scripts/ (migrations, seed).
# Copy from Supabase dashboard: Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (for `pnpm db:migrate` against the hosted project) -----------
# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Project ref (the subdomain of the API URL above)
SUPABASE_PROJECT_REF=
# Database password, set when the project was created (for `supabase db push`)
SUPABASE_DB_PASSWORD=
