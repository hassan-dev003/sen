# eslint-config-next pulls its plugins in as transitive deps. Flat config
# resolves plugins from the project root, so hoist the eslint toolchain there
# or `pnpm lint` cannot find eslint-plugin-react-hooks and friends.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@next/eslint-plugin-next
public-hoist-pattern[]=@typescript-eslint/*
